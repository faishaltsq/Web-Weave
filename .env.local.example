# =============================================
# WebWeave — AI Provider Configuration
# =============================================
# Salin file ini menjadi .env.local dan masukkan API Key untuk provider yang ingin digunakan.
# Minimal satu provider harus dikonfigurasi (atau input via UI browser).

# OpenCode Go (Recommended) — https://opencode.ai/auth
# $5 first month, 30K+ requests/5hr — DeepSeek V4, Qwen 3.7, Kimi K2.6, GLM-5.1
OPENCODE_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter (100+ models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================
# WebWeave — Supabase Backend/Data Layer
# =============================================
# Create a Supabase project, run supabase/migrations/001_initial_schema.sql,
# then fill these values. Service role key must stay server-side only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# WebWeave — LemonSqueezy Billing
# =============================================
# Values can be filled after LemonSqueezy store validation and product setup.
# Local webhook callback example: https://<ngrok-id>.ngrok-free.app/api/billing/webhook

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true

LEMONSQUEEZY_STARTER_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_STARTER_ANNUAL_VARIANT_ID=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
